# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/Autotrade?retryWrites=true&w=majority

# Server & Environment
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://auto-trade-amber.vercel.app

# Upstash Redis (REST API)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# CJ Dropshipping API
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0
CJ_API_KEY=your_cj_api_key
CJ_EMAIL=your_cj_email@domain.com
CJ_ACCESS_TOKEN=your_cj_access_token_if_persisted

# JWT Authentication
JWT_SECRET=your_strong_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_RETURN_BASE_URL=https://autotrade-1-k96m.onrender.com

# Admin Access Code
ADMIN_SECRET_CODE=your_admin_secret_code
ADMIN_ALERT_EMAIL=admin@example.com

# Mail / SMTP (Optional)
MAIL_USER=your_smtp_user
MAIL_PASS=your_smtp_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
MAIL_FROM="AutoTrade Support <support@autotrade.in>"
RESEND_API_KEY=re_your_resend_key_optional
